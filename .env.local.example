# IntaSend
# Get your keys from https://sandbox.intasend.com/account/api-keys/ (test) or https://payment.intasend.com/account/api-keys/ (live)
# Test keys are prefixed ISSecretKey_test_ and ISPubKey_test_
# Live keys are prefixed ISSecretKey_live_ and ISPubKey_live_
INTASEND_SECRET_KEY=ISSecretKey_test_your-secret-key-here
NEXT_PUBLIC_INTASEND_PUBLISHABLE_KEY=ISPubKey_test_your-publishable-key-here
# Set this to the challenge string you configure in the IntaSend dashboard under Webhooks
INTASEND_WEBHOOK_CHALLENGE=your-webhook-challenge-here

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Site URL (used for IntaSend redirect_url and sitemap generation)
# Local dev: http://localhost:3000
# Production (set in Vercel env vars, NOT here): https://nursefiti.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your-analytics-id

# Google Gemini (for student AI explanations — get free key at https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here
