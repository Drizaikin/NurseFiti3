# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# IntaSend
INTASEND_SECRET_KEY=your-intasend-secret-key
NEXT_PUBLIC_INTASEND_PUBLISHABLE_KEY=your-intasend-publishable-key
INTASEND_WEBHOOK_CHALLENGE=generate-a-long-random-challenge

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=your-twilio-whatsapp-number

# Site URL
NEXT_PUBLIC_SITE_URL=https://www.nursefiti.co.ke

# Gmail SMTP email notifications
SMTP_HOST=your-smtp-host
SMTP_PORT=465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
PAYMENT_EMAIL_FROM=NurseFiti <noreply@nursefiti.co.ke>

# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Google Calendar / Google Meet OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token

# Vercel cron authentication
CRON_SECRET=generate-a-long-random-cron-secret

# Draft-only blog orchestrator
# Store only the raw token's SHA-256 hash in the website environment.
BLOG_AUTOMATION_TOKEN_SHA256=64-character-lowercase-sha256-hex
BLOG_AUTOMATION_TOKEN=raw-token-used-by-the-external-worker-only
BLOG_AUTOMATION_INGEST_URL=https://www.nursefiti.co.ke/api/automation/blog-drafts
# Article drafting runs on OpenRouter. Kimi K3 is the approved writer model.
OPENROUTER_API_KEY=your-openrouter-api-key
BLOG_WRITER_MODEL=moonshotai/kimi-k3
DATAFORSEO_USERNAME=your-dataforseo-username
DATAFORSEO_PASSWORD=your-dataforseo-password

# Worker-only: Google Workspace, Drive, and image generation
GOG_CLI_PATH=C:\gogcli\gog.exe
GOG_ACCOUNT=the-google-account-that-owns-the-nursefiti-drive-folder
BLOG_KEYWORD_SHEET_ID=1z6_oQ9Tca05-NVbEN-wSjPz3n51CU3I07hNDfHEKo2o
BLOG_PUBLISHED_SHEET_ID=1Qxd6VDTs4e6NQMRd7byOBbqZifWKuqNBBwwJyc2FcaI
BLOG_DRIVE_DRAFTS_FOLDER_ID=1W5Vl0g4fCwrcPNYgWdjWlcSQOBWgj70n
BLOG_DRIVE_IMAGES_FOLDER_ID=create-a-blog-images-folder-and-put-its-id-here
KIE_API_KEY=your-kie-ai-api-key

# Optional admin upload notifications via Resend
RESEND_API_KEY=your-resend-api-key

# Optional: hand execution to an external agent instead of the local worker.
# When set, clicking Generate in /admin/blog/automation fires this webhook.
HYPERAGENT_WEBHOOK_URL=https://hyperagent.com/api/webhooks/<endpoint-id>/receive
HYPERAGENT_WEBHOOK_TOKEN=the-secret-shown-once-when-the-webhook-is-created
# Hyperagent sends its secret in its own header, not Authorization.
HYPERAGENT_WEBHOOK_HEADER=X-Hyperagent-Webhook-Secret
BLOG_AUTOMATION_IMAGE_URL=https://www.nursefiti.co.ke/api/automation/blog-images
